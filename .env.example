# Supabase（公開側：ブラウザから使う anon キー。RLS 前提）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase（サーバ専用：service_role キー。絶対にブラウザへ出さない）
# 用途: クリック記録の書き込み、承認済みデータの管理系処理など。
# 未設定でも公開ページは anon の範囲で動作する（その場合クリック記録は保存されない）。
SUPABASE_SERVICE_ROLE_KEY=

# サイトの公開URL（OGP等の絶対URL生成用。ドメインは未決のため仮）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
